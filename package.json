{
  "name": "xiv-studio-root",
  "version": "1.0.0",
  "description": "XIV STUDIO - WebStoreWithAI Monorepo",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "init:db": "cd backend && npm run db:init",
    "test:system": "cd backend && node test_system.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
